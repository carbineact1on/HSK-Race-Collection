<?xml version="1.0" encoding="utf-8"?>
<!-- HSK disables CE's 12x72mmCharged ammo by renaming its def file to .xml.bak, but the Wolfein
     AIPT Stun Rifle is CE-patched to fire it, so AmmoSet_12x72mmCharged / Bullet_12x72mmCharged
     dangled and the gun had no ammo (Uoipka report 2026-08; log: "Could not resolve
     cross-reference: No CombatExtended.AmmoSetDef named AmmoSet_12x72mmCharged").
     Per HSK convention we re-enable the ammo from inside our own mod rather than editing CE.
     Defs copied from CE's own .bak (CE's balance kept); crafting recipes converted to HSK
     materials (SLDBar/USLDBar + MagneticMaterial/SyntheticAmmonia), matching the
     Ammo_8x35mmCharged_SelfContained.xml pattern already in this mod.
     PatchOperationTest guard: if CE ever ships this caliber enabled, this whole block no-ops. -->
<Patch>
  <Operation Class="PatchOperationSequence">
    <success>Always</success>
    <operations>
      <li Class="PatchOperationTest">
        <xpath>Defs/CombatExtended.AmmoSetDef[defName="AmmoSet_12x72mmCharged"]</xpath>
        <success>Invert</success>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>Defs</xpath>
        <value>


	<ThingCategoryDef>
		<defName>Ammo12x72mmCharged</defName>
		<label>12x72mm Charged</label>
		<parent>AmmoAdvanced</parent>
		<iconPath>UI/Icons/ThingCategories/CaliberChargeLarge</iconPath>
	</ThingCategoryDef>

	<!-- ==================== AmmoSet ========================== -->

	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_12x72mmCharged</defName>
		<label>12x72mm Charged</label>
		<ammoTypes>
			<Ammo_12x72mmCharged>Bullet_12x72mmCharged</Ammo_12x72mmCharged>
			<Ammo_12x72mmCharged_AP>Bullet_12x72mmCharged_AP</Ammo_12x72mmCharged_AP>
			<Ammo_12x72mmCharged_Ion>Bullet_12x72mmCharged_Ion</Ammo_12x72mmCharged_Ion>
		</ammoTypes>
		<similarTo>AmmoSet_ChargedHeavy</similarTo>
	</CombatExtended.AmmoSetDef>

	<!-- ==================== Ammo ========================== -->

	<ThingDef Class="CombatExtended.AmmoDef" Name="12x72mmChargedBase" ParentName="SpacerMediumAmmoBase" Abstract="True">
		<description>High-caliber charged shot ammo used by advanced heavy machine guns and anti-materiel rifles.</description>
		<statBases>
			<Mass>0.058</Mass>
			<Bulk>0.05</Bulk>
		</statBases>
		<tradeTags>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting_FabricationBench</li>
		</tradeTags>
		<thingCategories>
			<li>Ammo12x72mmCharged</li>
		</thingCategories>
		<stackLimit>5000</stackLimit>
	</ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="12x72mmChargedBase">
		<defName>Ammo_12x72mmCharged</defName>
		<label>12x72mm Charged</label>
		<graphicData>
			<texPath>Things/Ammo/Charged/LargeRegular</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<ammoClass>Charged</ammoClass>
	</ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="12x72mmChargedBase">
		<defName>Ammo_12x72mmCharged_AP</defName>
		<label>12x72mm Charged (Conc.)</label>
		<graphicData>
			<texPath>Things/Ammo/Charged/LargeConc</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<ammoClass>ChargedAP</ammoClass>
	</ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="12x72mmChargedBase">
		<defName>Ammo_12x72mmCharged_Ion</defName>
		<label>12x72mm Charged (Ion)</label>
		<graphicData>
			<texPath>Things/Ammo/Charged/LargeIon</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<ammoClass>Ionized</ammoClass>
		<generateAllowChance>0.5</generateAllowChance>
	</ThingDef>

	<!-- ================== Projectiles ================== -->

	<ThingDef Name="Base12x72mmChargedBullet" ParentName="BaseBulletCE" Abstract="true">
		<graphicData>
			<texPath>Things/Projectile/Charged/ChargeShot</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1.3,1.3)</drawSize>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageDef>Bullet</damageDef>
			<speed>165</speed>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="Base12x72mmChargedBullet">
		<defName>Bullet_12x72mmCharged</defName>
		<label>12x72mm Charged bullet</label>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageAmountBase>39</damageAmountBase>
			<secondaryDamage>
				<li>
					<def>Bomb_Secondary</def>
					<amount>12</amount>
				</li>
			</secondaryDamage>
			<armorPenetrationSharp>30</armorPenetrationSharp>
			<armorPenetrationBlunt>324</armorPenetrationBlunt>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="Base12x72mmChargedBullet">
		<defName>Bullet_12x72mmCharged_AP</defName>
		<label>12x72mm Charged bullet (Conc.)</label>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageAmountBase>31</damageAmountBase>
			<secondaryDamage>
				<li>
					<def>Bomb_Secondary</def>
					<amount>5</amount>
				</li>
			</secondaryDamage>
			<armorPenetrationSharp>60</armorPenetrationSharp>
			<armorPenetrationBlunt>324</armorPenetrationBlunt>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="Base12x72mmChargedBullet">
		<defName>Bullet_12x72mmCharged_Ion</defName>
		<label>12x72mm Charged bullet (Ion)</label>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageAmountBase>31</damageAmountBase>
			<secondaryDamage>
				<li>
					<def>EMP</def>
					<amount>18</amount>
				</li>
			</secondaryDamage>
			<armorPenetrationSharp>45</armorPenetrationSharp>
			<armorPenetrationBlunt>324</armorPenetrationBlunt>
			<empShieldBreakChance>1</empShieldBreakChance>
		</projectile>
	</ThingDef>

	<!-- ==================== Recipes ========================== -->

	<RecipeDef ParentName="AmmoRecipeBase">
		<defName>MakeAmmo_12x72mmCharged</defName>
		<label>make 12x72mm Charged x80</label>
		<description>Craft 12x72mm Charged.</description>
		<jobString>Making 12x72mm Charged.</jobString>
		<ingredients>
			<li>
				<filter>
					<categories>
						<li>SLDBar</li>
						<li>USLDBar</li>
					</categories>
				</filter>
				<count>6</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>MagneticMaterial</li>
					</thingDefs>
				</filter>
				<count>2</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>MagneticMaterial</li>
			</thingDefs>
			<categories>
				<li>SLDBar</li>
				<li>USLDBar</li>
			</categories>
		</fixedIngredientFilter>
		<products>
			<Ammo_12x72mmCharged>80</Ammo_12x72mmCharged>
		</products>
	</RecipeDef>

	<RecipeDef ParentName="AmmoRecipeBase">
		<defName>MakeAmmo_12x72mmCharged_AP</defName>
		<label>make 12x72mm Charged (Conc.) x80</label>
		<description>Craft 12x72mm Charged (Conc.).</description>
		<jobString>Making 12x72mm Charged (Conc.).</jobString>
		<ingredients>
			<li>
				<filter>
					<categories>
						<li>SLDBar</li>
						<li>USLDBar</li>
					</categories>
				</filter>
				<count>6</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>MagneticMaterial</li>
					</thingDefs>
				</filter>
				<count>2</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>MagneticMaterial</li>
			</thingDefs>
			<categories>
				<li>SLDBar</li>
				<li>USLDBar</li>
			</categories>
		</fixedIngredientFilter>
		<products>
			<Ammo_12x72mmCharged_AP>80</Ammo_12x72mmCharged_AP>
		</products>
	</RecipeDef>

	<RecipeDef ParentName="AmmoRecipeBase">
		<defName>MakeAmmo_12x72mmCharged_Ion</defName>
		<label>make 12x72mm Charged (Ion) x80</label>
		<description>Craft 12x72mm Charged (Ion).</description>
		<jobString>Making 12x72mm Charged (Ion).</jobString>
		<ingredients>
			<li>
				<filter>
					<categories>
						<li>SLDBar</li>
						<li>USLDBar</li>
					</categories>
				</filter>
				<count>6</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>SyntheticAmmonia</li>
					</thingDefs>
				</filter>
				<count>5</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>MagneticMaterial</li>
					</thingDefs>
				</filter>
				<count>2</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>MagneticMaterial</li>
				<li>SyntheticAmmonia</li>
			</thingDefs>
			<categories>
				<li>SLDBar</li>
				<li>USLDBar</li>
			</categories>
		</fixedIngredientFilter>
		<products>
			<Ammo_12x72mmCharged_Ion>80</Ammo_12x72mmCharged_Ion>
		</products>
	</RecipeDef>

        </value>
      </li>
    </operations>
  </Operation>
</Patch>
